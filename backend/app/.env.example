DATABASE_URL="postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>"
JWT_SECRET="<random hex string, e.g. python3 -c 'import secrets; print(secrets.token_hex(32))'>"

# Google OAuth -- optional. Leave blank and the "Continue with Google" button
# is hidden and the routes return 503; password auth works either way.
# Create a client at console.cloud.google.com -> APIs & Services -> Credentials
# -> OAuth client ID -> Web application, and register the redirect URI below
# EXACTLY as written (scheme, host, port and path must all match).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8010/auth/google/callback"
